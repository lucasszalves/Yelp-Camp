<% layout('layouts/boilerplate') %>
<div class="row">
    <div class="col-6 offset-3">
        <div class="card mb-3">
            <img src="<%= campground.image %>" class="card-img-top" alt="...">
            <div class="card-body">
                <h3 class="card-title"><%= campground.title %></h3>
                <p class="card-text"><%= campground.description %></p>
                <p class="card-text text-muted"><%= campground.city %>, <%= campground.state %></p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">R$<%= campground.price.toFixed(2) %>/night</li>
            </ul>
            <div class="card-body">
                <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-info">Edit campground</a>
                <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-danger">Delete campground</button>
                </form>
            </div>
            <div class="card-footer text-muted">2 days ago</div>
        </div>
    </div>
</div>