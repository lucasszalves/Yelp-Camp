<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Campground</title>
</head>

<body>
    <h1>New campground</h1>
    <form action="/campgrounds" method="POST">
        <div>
            <label for="title">Title:</label>
            <input type="text" name="campground[title]" id="title" placeholder="Ex.: Pico da Neblina">
            <!--                     fica guardado dentro de um objeto "campground" no corpo da request -->
            <label for="city">City:</label>
            <input type="text" name="campground[city]" id="city">
            <label for="state">State:</label>
            <input type="text" name="campground[state]" id="state">
            <button>Add campground!</button>
        </div>
    </form>
    <footer>
        <a href="/campgrounds">Back to main page</a>
    </footer>
</body>

</html>