<% layout('layouts/boilerplate') %>
<div class="row">
    <h1 class="text-center">Edit Campground</h1>
    <div class="col-6 offset-3">
        <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST"">
            <div class=" mb-3">
            <label class="form-label" for="title">Title:</label>
            <input class="form-control" type="text" name="campground[title]" id="title" value="<%= campground.title %>">
    </div>
    <div class="mb-3">
        <label class="form-label" for="city">City:</label>
        <input class="form-control" type="text" name="campground[city]" id="city" value="<%= campground.city %>">
    </div>
    <div class="mb-3">
        <label class="form-label" for="state">State:</label>
        <input class="form-control" type="text" name="campground[state]" id="state" value="<%= campground.state %>">
    </div>
    <div class="mb-3">
        <label class="form-label" for="image">Image URL:</label>
        <input class="form-control" type="text" name="campground[image]" id="image" value="<%= campground.image %>">
    </div>
    <div class="mb-3">
        <label for="price" class="form-label">Price:</label>
        <div class="input-group">
            <span class="input-group-text" id="price-label">R$</span>
            <input type="text" id="price" class="form-control" aria-label="Amount (to the nearest real)"
                aria-describedby="price-label" name="campground[price]" value="<%= campground.price %>">
            <span class="input-group-text">.00</span>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="description">Description:</label>
        <textarea class="form-control" type="text" name="campground[description]"
            id="description"><%= campground.description %></textarea>
    </div>
    <button class="btn btn-success mb-3">Update campground!</button>
    </form>
    <footer>
        <a href="/campgrounds/<%= campground._id %>" class="btn btn-secondary mb-3">Back to campground</a>
    </footer>
</div>
</div>